# Copy to .env and adjust. Relative paths are resolved against the project root.
DEVPILOT_WORKSPACE=./workspace

# Optional. Only needed for private repositories or a higher GitHub API rate limit.
# Use a fine-grained personal access token limited to the one repository, with
# read-only repository permissions: Metadata, Issues and Pull requests.
# Never commit a real token; .env is git-ignored.
GITHUB_TOKEN=

# Optional. The Python that run_tests uses. Defaults to the interpreter running
# DevPilot. Set an ABSOLUTE path to a project's own interpreter (for example its
# venv's python.exe) when its test dependencies are installed there.
# DEVPILOT_TEST_PYTHON=
